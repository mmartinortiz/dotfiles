{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "instructions": [
    "~/.agents/skills/caveman/SKILL.md",
    "~/.config/opencode/websearch.md"
  ],
  "mcp": {
    "ddg": {
      "type": "local",
      "command": ["uvx", "duckduckgo-mcp-server"],
      "enabled": true,
      "environment": {
        "DDG_SAFE_SEARCH": "STRICT",
        "DDG_REGION": "uk-en"
      }
    }
  },
  "formatter": true
}
